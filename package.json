{
  "name": "aiartengine",
  "version": "5.0.7",
  "description": "AIArtEngine — professional AI creation tool for short drama, ads, and film",
  "main": "./out/main/index.js",
  "author": "AIArtEngine",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Justin-sky/ai-art-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justin-sky/ai-art-engine.git"
  },
  "bugs": {
    "url": "https://github.com/Justin-sky/ai-art-engine/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "check:cjk": "node scripts/check-hardcoded-cjk.mjs --enforce",
    "lint": "eslint . && npm run check:cjk",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle:dsh": "node scripts/bundle-dsh.mjs",
    "lock:update": "npm install --package-lock-only --no-audit --no-fund",
    "pack": "npm run build && npm run bundle:dsh && electron-builder --dir",
    "dist": "npm run build && npm run bundle:dsh && electron-builder",
    "dist:win": "npm run build && npm run bundle:dsh && electron-builder --win",
    "dist:mac": "npm run build && npm run bundle:dsh && electron-builder --mac --x64 --arm64",
    "dist:linux": "npm run build && npm run bundle:dsh && electron-builder --linux",
    "site": "npx --yes serve website -p 5174",
    "site:deploy": "node scripts/deploy-website-oss.mjs"
  },
  "dependencies": {
    "@cordisjs/core": "^3.18.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@volcengine/tos-sdk": "^2.9.1",
    "ag-psd": "^31.0.2",
    "ali-oss": "^6.23.0",
    "axios": "^1.10.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dockview-vue": "^7.0.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fabric": "^7.4.0",
    "gpt-tokenizer": "^3.4.0",
    "jszip": "^3.10.1",
    "pinia": "^3.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.17",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.15.32",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.10"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.1-rc.2": true,
    "@google/genai@1.52.0": true,
    "electron@35.2.1": true,
    "esbuild@0.25.12": true,
    "koffi@3.1.6": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "tos-crc64-js@0.0.1": true
  }
}
