#!/bin/sh
# ---------------------------------------------------------------------------
# commit-msg —— 拦截「被 Windows 代码页(936/GBK) 损坏」的提交信息
#
# 症状：git log 里出现 "绉诲姩鏂囦欢澶" 之类乱码。
#       本质是中文的 UTF-8 字节先被按 GBK 解码、又被当成 UTF-8 写进了 commit 对象。
# 典型来源：PowerShell 5.1 会把「无 BOM 的 UTF-8 脚本」按系统 ANSI 代码页
#       (本机为 936) 解读，脚本里写在命令行上的中文还没交给 git 就已经是乱码了。
#
# 本钩子只拦截、不自动改写（乱码还原可能是有损的，交人工确认更安全）。
#
# 正确姿势（任选其一）：
#   1) 把信息写成 UTF-8(无 BOM) 文件，再 git commit -F <文件>
#   2) 用 PowerShell 7(pwsh) 执行 git，或先执行 chcp 65001
#   3) 系统级：区域设置勾选 "Beta: 使用 Unicode UTF-8 提供全球语言支持"
# 若确认信息本身没问题，可用 git commit --no-verify 跳过本钩子。
# ---------------------------------------------------------------------------

msg_file=${1:-}
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

# 纯 ASCII 的提交信息直接放行
if ! LC_ALL=C grep -q '[^ -~]' "$msg_file"; then
	exit 0
fi

# UTF-8 被按 GBK 误解码后的典型产物字（正常中文里几乎不会这么集中出现）
hits=$(LC_ALL=C grep -oE '锛|銆|鈥|鐨|涓|鏄|鍦|浣|涔|鍑|鏂|绉|缁|閫|鏃|鎴|鍔|鑺|鐭|閿|鑳' "$msg_file" | LC_ALL=C sort -u | LC_ALL=C wc -l | tr -d ' ')

# 出现 2 个以上不同的乱码特征字，或含 U+FFFD 替换字符，即判定为损坏
if [ "${hits:-0}" -lt 2 ] && ! LC_ALL=C grep -qF "$(printf '\357\277\275')" "$msg_file"; then
	exit 0
fi

cat >&2 <<'EOF'
------------------------------------------------------------------
commit-msg: 提交信息疑似编码损坏（GBK 乱码），已中止本次提交。

原因：中文在写入提交对象前经过了 Windows ANSI 代码页(936/GBK) 的误解码。
解决办法（任选其一）：
  1) 把信息写成 UTF-8(无 BOM) 文件，然后： git commit -F <文件>
  2) 用 PowerShell 7(pwsh) 执行 git，或先执行： chcp 65001
  3) 系统级：区域设置勾选 “Beta: 使用 Unicode UTF-8 提供全球语言支持”
如果确认信息本身没问题，可加 --no-verify 跳过本钩子。
------------------------------------------------------------------
EOF
exit 1
