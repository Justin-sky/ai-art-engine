  "rules": [
    { "match": "seedream[-_]?5|seedream[-_]?5\\.0", "profile": "seedream-5" },
    { "match": "seedream[-_]?4[-_.]?5|seedream[-_]?4\\.5", "profile": "seedream-4.5" },
    { "match": "seedream[-_]?4([-_.]?0)?(?![-_.]?5)", "profile": "seedream-4" },
    { "match": "seedream[-_]?3|seedream[-_]?3\\.0", "profile": "seedream-3" },
    { "match": "seedream", "profile": "seedream-4.5" },
    { "match": "seedance[-_]?2[-_.]?5", "profile": "seedance-2.5" },
    { "match": "seedance[-_]?2([-_.]?0)?[-_]?fast|seedance[-_]?2\\.0[-_]?fast", "profile": "seedance-2-fast" },
    { "match": "seedance[-_]?2([-_.]?0)?(?![-_]?fast)|seedance[-_]?2\\.0(?![-_]?fast)", "profile": "seedance-2" },
    { "match": "seedance[-_]?1[-_.]?5|seedance[-_]?1\\.5", "profile": "seedance-1.5" },
    { "match": "seedance[-_]?1([-_.]?0)?[-_]?lite[-_]?i2v|seedance.*lite.*i2v", "profile": "seedance-1-lite-i2v" },
    { "match": "seedance[-_]?1|seedance", "profile": "seedance-1" }
