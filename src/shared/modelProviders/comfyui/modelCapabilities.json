{
  "meta": {
    "docs": [
      "https://docs.comfy.org/api-reference/v2/jobs/submit-a-workflow-for-execution"
    ],
    "note": "Comfy API v2. Default Base URL is local comfy-api-proxy (127.0.0.1:8189). Cloud: https://cloud.comfy.org. Model id = API-format workflow name in ComfyUI userdata."
  },
  "profiles": {
    "image-base": {
      "modality": "image",
      "label": "ComfyUI Image",
      "capabilities": {
        "supported_parameters": {
          "aspect_ratio": {
            "values": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"]
          },
          "resolution": {
            "values": ["1k", "2k"]
          },
          "n": { "min": 1, "max": 1 },
          "input_references": { "max": 0 }
        }
      }
    },
    "image-ref": {
      "modality": "image",
      "label": "ComfyUI Image (ref)",
      "capabilities": {
        "supported_parameters": {
          "aspect_ratio": {
            "values": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"]
          },
          "resolution": {
            "values": ["1k", "2k"]
          },
          "n": { "min": 1, "max": 1 },
          "input_references": { "max": 1 }
        }
      }
    },
    "video-base": {
      "modality": "video",
      "label": "ComfyUI Video",
      "capabilities": {
        "supported_resolutions": ["720p", "1080p"],
        "supported_aspect_ratios": ["16:9", "9:16", "1:1"],
        "supported_durations": [5, 8, 10],
        "supported_frame_images": [],
        "generate_audio": false,
        "max_input_images": 0,
        "max_input_videos": 0,
        "max_input_audios": 0,
        "supported_parameters": {
          "input_references": { "max": 0 }
        }
      }
    },
    "video-ref": {
      "modality": "video",
      "label": "ComfyUI Video (ref)",
      "capabilities": {
        "supported_resolutions": ["720p", "1080p"],
        "supported_aspect_ratios": ["16:9", "9:16", "1:1"],
        "supported_durations": [5, 8, 10],
        "supported_frame_images": ["first_frame"],
        "generate_audio": false,
        "max_input_images": 1,
        "max_input_videos": 0,
        "max_input_audios": 0,
        "supported_parameters": {
          "input_references": { "max": 1 }
        }
      }
    },
    "audio-base": {
      "modality": "audio",
      "label": "ComfyUI Audio",
      "capabilities": {
        "supported_parameters": {}
      }
    }
  }
}
